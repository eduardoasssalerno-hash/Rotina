{
  // Publicação no Cloudflare (Worker + arquivos estáticos)
  "name": "rotina",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Mantém o endereço gratuito rotina.<conta>.workers.dev sempre ligado
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Os PDFs passam primeiro pelo Worker, que confere o login
    "run_worker_first": ["/arquivos/*"]
  }
}
